#!/usr/bin/env python3
"""AWS credential_process endpoint. Invoke through an AWS SDK, never directly."""

import argparse
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time


FIELDS = {"AWS_ACCESS_KEY_ID": "AccessKeyId", "AWS_SECRET_ACCESS_KEY": "SecretAccessKey"}
TIMEOUT_SECONDS = 300


def log(message):
    print(f"op-aws-credential-process: {message}", file=sys.stderr, flush=True)


def validate_env_file(path):
    """Accept only two literal secret references, belonging to the same item."""
    info = path.stat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("env file must be an owner-only regular file (chmod 600)")
    references = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        elif "#" in value:
            raise ValueError("env file does not accept inline comments")
        if not separator or key not in FIELDS or key in references:
            raise ValueError("env file must contain exactly the two AWS credential variables")
        if not re.fullmatch(r"op://[^/\r\n]+/[^/\r\n]+/(?:[^/\r\n]+/)?[^/\r\n]+", value) or any(c in value for c in "$\\\"'"):
            raise ValueError("env file must contain literal op references, without interpolation")
        references[key] = value.split("/")[2:4]
    if set(references) != set(FIELDS) or len({tuple(v) for v in references.values()}) != 1:
        raise ValueError("both credential fields must reference the same vault and item")


def emit_credentials():
    values = {field: os.environ.get(variable, "") for variable, field in FIELDS.items()}
    if any(not value or value.startswith("op://") for value in values.values()):
        log("failed: credential fields missing or unresolved")
        return 1
    print(json.dumps({"Version": 1, **values}))
    return 0


def fetch_credentials(account, env_file):
    # Do not inherit other accounts, service-account/Connect tokens, AWS credentials,
    # or unrelated references that `op run` would otherwise also resolve.
    environment = {key: value for key, value in os.environ.items()
                   if key in {"HOME", "PATH", "USER", "LOGNAME", "LANG", "TMPDIR", "XDG_CONFIG_HOME"}
                   or key.startswith("LC_")}
    command = ["op", "run", "--account", account, "--env-file", str(env_file),
               "--no-masking", "--", sys.executable, str(Path(__file__).resolve()), "--emit"]
    log("start: requesting credentials from the selected 1Password account")
    started = time.monotonic()
    # Keep the caller's terminal session for 1Password authorization reuse, while
    # giving timeout cleanup its own process group (Python 3.11+).
    with subprocess.Popen(command, env=environment, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, process_group=0) as process:
        try:
            while True:
                remaining = TIMEOUT_SECONDS - (time.monotonic() - started)
                if remaining <= 0:
                    raise TimeoutError
                try:
                    output, error = process.communicate(timeout=min(15, remaining))
                    break
                except subprocess.TimeoutExpired:
                    log("waiting: 1Password authorization or credential retrieval")
        except (TimeoutError, KeyboardInterrupt):
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
            log("failed: timeout or interruption; no retry or account switch")
            return 1
    if process.returncode:
        # Never forward provider stderr: it can contain references or secret values.
        message = error.decode(errors="replace").lower()
        kind = "credential retrieval failed"
        for signature, description in (
            ("account is not signed in", "account is not signed in"),
            ("prompterror", "authorization prompt error"),
            ("authorization prompt dismissed", "authorization dismissed"),
            ("authorization timeout", "authorization timeout"),
            ("does not have a field", "referenced field not found"),
            ("isn't an item", "referenced item not found"),
            ("could not find", "referenced item or field not found"),
        ):
            if signature in message:
                kind = description
                break
        log(f"failed: {kind} (op exit {process.returncode}); no retry or account switch")
        return 1
    try:
        credentials = json.loads(output)
        if (not isinstance(credentials, dict) or credentials.get("Version") != 1
                or set(credentials) != {"Version", *FIELDS.values()}
                or any(not isinstance(credentials[field], str) or not credentials[field]
                       or credentials[field].startswith("op://") for field in FIELDS.values())):
            raise ValueError
    except (ValueError, TypeError, UnicodeError):
        log("failed: invalid credential response")
        return 1
    log("complete: credentials delivered to the AWS SDK")
    print(json.dumps(credentials))
    return 0


def main():
    # This prevents accidental terminal display/file redirection, not hostile callers.
    if not stat.S_ISFIFO(os.fstat(sys.stdout.fileno()).st_mode):
        log("failed: stdout must be the AWS SDK credential pipe")
        return 1
    if sys.argv[1:] == ["--emit"]:
        return emit_credentials()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--account", required=True)
    parser.add_argument("--env-file", type=Path, required=True)
    args = parser.parse_args()
    try:
        if not args.account.strip() or not args.env_file.is_absolute():
            raise ValueError("an explicit account and absolute env-file path are required")
        validate_env_file(args.env_file)
        return fetch_credentials(args.account, args.env_file)
    except ValueError as error:
        log(f"failed: {error}")
        return 1
    except OSError:
        log("failed: local env file or 1Password CLI unavailable")
        return 1


if __name__ == "__main__":
    sys.exit(main())
