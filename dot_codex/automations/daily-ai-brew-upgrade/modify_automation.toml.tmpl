#!/usr/bin/env python3
"""chezmoi modify_ script for a Codex Desktop automation definition.

Merges the managed fields below into the file already on disk instead of
replacing it. Codex Desktop writes machine-local values into these files —
the resolved project target and the created/updated timestamps — and a plain
managed file would delete them on every apply. Managed keys win; anything else
already present is kept.
"""

MANAGED = r"""
version = 1
id = "daily-ai-brew-upgrade"
kind = "cron"
name = "Daily AI Brew Upgrade"
prompt = "Homebrew でインストール済みの AI 関連ツール `codex` `claude-code` `antigravity-cli`（binary: `agy`） `copilot-cli` `gh` `hermes-agent` の更新有無を確認し、古いものだけ更新してください。formula と cask の区別に合わせて安全に実行し、更新されたものについては更新前後のバージョン、パッケージ種別、失敗があれば原因を整理して inbox に報告してください。`grok` は Homebrew 管理ではなく CLI 内蔵 updater を使い、`grok update --check` で更新有無を確認し、更新が必要なときだけ `grok update` を実行してください。変更点は可能な範囲で各ツールの公式リリースノートや公開リリース情報を確認し、機能追加を中心に差分を表示してください。報告フォーマットは CLI ごとのセクション構成に固定し、各セクションに `種別` `バージョン` `結果` `変更点` `参照` を含め、`変更点` は bullet list で書いてください。先頭には `概要` として更新あり件数、更新なし件数、失敗件数を置いてください。更新がなければ、更新なしとだけ簡潔に報告してください。作業中の一時ファイルや中間出力は、リポジトリ直下ではなく `.context/brew/` 配下に生成してください。"
status = "ACTIVE"
rrule = "RRULE:FREQ=WEEKLY;BYHOUR=8;BYMINUTE=0;BYDAY=SU,MO,TU,WE,TH,FR,SA"
model = "gpt-5.6-luna"
reasoning_effort = "low"
execution_environment = "local"
cwds = ["{{ .chezmoi.homeDir }}/.local/share/chezmoi"]
"""

import re
import sys
from collections import OrderedDict

KEY_RE = re.compile(r'\s*([A-Za-z0-9_.\-]+)\s*=')


def key_of(line):
    m = KEY_RE.match(line)
    return m.group(1) if m else None


def main():
    existing = sys.stdin.read().splitlines()
    managed = OrderedDict()
    for line in MANAGED.strip().splitlines():
        k = key_of(line)
        if k:
            managed[k] = line

    out, applied = [], set()
    for line in existing:
        k = key_of(line)
        if k and k in managed:
            if k not in applied:
                out.append(managed[k])
                applied.add(k)
        else:
            out.append(line)
    for k, line in managed.items():
        if k not in applied:
            out.append(line)

    while out and not out[-1].strip():
        out.pop()
    sys.stdout.write("\n".join(out) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
