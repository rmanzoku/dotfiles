#!/usr/bin/env python3
"""chezmoi modify_ script for a Codex Desktop automation definition.

Merges the managed fields below into the file already on disk instead of
replacing it. Codex Desktop writes machine-local values into these files —
the resolved project target and the created/updated timestamps — and a plain
managed file would delete them on every apply. Managed keys win; anything else
already present is kept. The owner-specific prompt and app target fields
remain machine-local and must be configured before applying this definition.
"""

MANAGED = r"""
version = 1
id = "changer-issue-intake"
kind = "cron"
name = "Changer Issue Intake"
status = "PAUSED"
rrule = "RRULE:FREQ=WEEKLY;BYHOUR=9;BYMINUTE=0;BYDAY=MO,TU,WE,TH,FR"
model = "gpt-5.6-sol"
reasoning_effort = "high"
execution_environment = "local"
"""

import re
import sys
from collections import OrderedDict

KEY_RE = re.compile(r'\s*([A-Za-z0-9_.\-]+)\s*=')


def key_of(line):
    m = KEY_RE.match(line)
    return m.group(1) if m else None


def main():
    existing = sys.stdin.read().splitlines()
    if not any(re.match(r'\s*prompt\s*=\s*".+"\s*$', line) for line in existing):
        print("Owner-specific automation prompt is missing; configure it in Codex before applying.", file=sys.stderr)
        return 66

    managed = OrderedDict()
    for line in MANAGED.strip().splitlines():
        k = key_of(line)
        if k:
            managed[k] = line

    out, applied = [], set()
    for line in existing:
        k = key_of(line)
        if k and k in managed:
            if k not in applied:
                out.append(managed[k])
                applied.add(k)
        else:
            out.append(line)
    for k, line in managed.items():
        if k not in applied:
            out.append(line)

    while out and not out[-1].strip():
        out.pop()
    sys.stdout.write("\n".join(out) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
