#!/bin/bash
set -eu

# Claude Code の PreToolUse hook から呼ばれるスクリプト
# chezmoi ソースと実機の差分がある場合にコミットをブロックする

# Bash ツールの呼び出し情報は stdin JSON で渡される。git commit 以外は何もしない。
payload="$(cat)"
tool_command="$(printf '%s' "$payload" | python3 -c 'import json,sys; data=json.load(sys.stdin); print(data.get("tool_input", {}).get("command", ""))')"

case "$tool_command" in
  git\ commit* ) ;;
  * ) exit 0 ;;
esac

# chezmoi が利用可能か確認
if ! command -v chezmoi >/dev/null 2>&1; then
  exit 0
fi

# 以降の警告・ブロック理由は hook プロトコルに従い stderr へ出す
# （exit 2 のとき Claude Code は stderr をフィードバックとして表示する）
exec 1>&2

if ! scripts/chezmoi-drift --check-ignore >/dev/null 2>&1; then
  echo "chezmoi の source state と .chezmoiignore の不整合を検出しました。"
  echo ""
  echo "確認方法:"
  echo "  scripts/chezmoi-drift --check-ignore"
  echo ""
  echo ".chezmoiignore を修正してからコミットしてください。"
  exit 2
fi

# chezmoi diff を実行
diff_output="$(chezmoi diff 2>/dev/null || true)"

if [ -z "$diff_output" ]; then
  exit 0
fi

# アプリが実行時に書き換える app 管理ファイル（glob 可）。ドリフトは警告表示のみでブロックしない。
# 追加・削除する場合は docs/adr/0051 の判断を更新すること。
APP_MANAGED_DRIFT_ALLOWLIST=".codex/config.toml .codex/automations/*/automation.toml"

# 差分ファイル一覧を抽出（mode のみの差分でも現れる diff --git 行を使う）
drifted_files="$(echo "$diff_output" | sed -n 's|^diff --git a/\(.*\) b/.*|\1|p' | sort -u)"

blocking_files=""
allowed_files=""
while IFS= read -r drifted; do
  [ -z "$drifted" ] && continue
  is_allowed=false
  for allowed in $APP_MANAGED_DRIFT_ALLOWLIST; do
    case "$drifted" in
      $allowed)
        is_allowed=true
        break
        ;;
    esac
  done
  if [ "$is_allowed" = true ]; then
    allowed_files="${allowed_files}  ${drifted}
"
  else
    blocking_files="${blocking_files}  ${drifted}
"
  fi
done <<< "$drifted_files"

if [ -n "$allowed_files" ]; then
  echo "app 管理ファイルのドリフトを検出しました（警告のみ、コミットはブロックしません）:"
  printf '%s' "$allowed_files"
  echo "取り込みや復元が必要な場合は scripts/chezmoi-drift を明示的に実行してください。"
fi

if [ -z "$blocking_files" ]; then
  exit 0
fi

echo "chezmoi ドリフトを検出しました。コミット前に解消してください。"
echo ""
echo "差分のあるファイル:"
printf '%s' "$blocking_files" | head -20
echo ""
echo "解消方法:"
echo "  scripts/chezmoi-drift --apply   (外部の変更を取り込む)"
echo "  scripts/chezmoi-drift --restore (chezmoi ソースの状態に戻す)"

exit 2
